# Apache config for jessejay.ch
# Enables Brotli (with gzip fallback) and long cache lifetimes for static assets.
# Requires mod_brotli (Apache 2.4+) and mod_headers, mod_deflate, mod_filter, mod_rewrite.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve precompressed Brotli assets when supported and available.
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+)$ $1.br [L]

  # Fallback to precompressed gzip assets.
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+)$ $1.gz [L]
</IfModule>

<IfModule mod_headers.c>
  # Correct Content-Encoding for precompressed files.
  <FilesMatch "\.br$">
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.gz$">
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
  </FilesMatch>

  # Long cache for fingerprinted/stable assets.
  <FilesMatch "\.(css|js|woff2?|ttf|webp|gif|jpg|jpeg|png|svg|ico|swf|mov)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Security headers.
  Header set X-Content-Type-Options nosniff
  Header set X-Frame-Options SAMEORIGIN
  Header set Referrer-Policy strict-origin-when-cross-origin
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
